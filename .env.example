# ==============================================================================
# SEPLE NovaEdge AI Operations Engine — Environment Configuration Template
# Copy this file to .env on your AWS EC2/Lightsail instance and fill in credentials.
# ==============================================================================

# 1. ThingsBoard Cloud Instance
TB_HOST=https://seple.iot-private.cloud
TB_EMAIL=your_thingsboard_email@seple.in
TB_PASSWORD=your_thingsboard_password

# 2. Slack Alerting (Incoming Webhook)
# Create webhook at: https://api.slack.com/apps -> Incoming Webhooks
SLACK_WEBHOOK=https://hooks.slack.com/services/REPLACE_WITH_YOUR_SLACK_WEBHOOK

# 3. Email Alerting (SMTP via Gmail or AWS SES)
# If using Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_notification_sender@gmail.com
SMTP_PASSWORD=your_16_char_app_password
EMAIL_TO=animesh.choudhury@seple.in

# 4. Scheduling Parameters (Cloud Runner)
# UTC Hour for Morning Digest (06:00 UTC = 11:30 AM IST)
DIGEST_HOUR_UTC=6
# Frequency in minutes for probing restored devices & auto-clearing alarms
POLL_INTERVAL_MINUTES=15
