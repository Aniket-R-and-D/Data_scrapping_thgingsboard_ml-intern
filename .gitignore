# Environment variables
.env
ml-intern/.env

# Gate A live-polling approval (real approver identity; template is tracked)
configs/gate_a_approval.yaml

# Weights-incident decision record (template is tracked)
configs/weights_incident_decision.yaml

# Temporary files & IDE configs
~$*
.ipynb_checkpoints/
__pycache__/
*.pyc
.idea/
.venv/
smoke_test.log
desktop.ini
backup/

# Tool caches / local agent state (pytest audit dirs are permission-locked)
.pytest_cache/
.ruff_cache/
.audit_pytest*/
.review_pytest*/
.playwright-mcp/
.claude-flow/
.code-review-graph/
session-*.md

# Generated harvest outputs (too bulky for git; re-pullable)
data_harvest/
harvest_cache/
excel/
csv/
json/
jsonl/

# Generated datasets (re-buildable; contain tenant device identifiers)
training_data/
data/
archive/

# Executed-notebook outputs (papermill writes here, never in-place)
executed/
audit_reports/

# Tenant-derived snapshot data (never publish: device/branch identifiers)
current_state_snapshots/*.csv
current_state_snapshots/*.json

# Run logs and crash dumps
*.log

# Model weights (hashes pinned in configs/release.yaml and reports/release_*.md)
*.joblib
*.pt
*.pth
*.pkl
*.safetensors
*.bin
*.gguf

# Whitelist compact production models required for AWS deployment (<30MB each)
!models/gbm_outage_oct2026_365d/*.joblib
!models/gbm_outage_365d_bridged/*.joblib
!models/isolation_forest_365d/*.joblib

# Legacy root-level stragglers (locked files that could not be moved)
ml_training_*.jsonl
*.ipynb.pre-organize.bak
